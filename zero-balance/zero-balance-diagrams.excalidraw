      "link": null,
      "locked": false,
      "text": "{\n    iterable() {\n        const protocol = ...;\n        switch (protocol) {\n            case 'multipart':\n                return ...;\n            case 'sse':\n                return ...;\n        }\n    }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n    iterable() {\n        const protocol = ...;\n        switch (protocol) {\n            case 'multipart':\n                return ...;\n            case 'sse':\n                return ...;\n        }\n    }\n}",
