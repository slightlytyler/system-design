      "link": null,
      "locked": false,
      "text": "- Extends AsyncIterable\n- Allows for rereading without manually cloning / teeing\n- Allows for transforming values",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Extends AsyncIterable\n- Allows for rereading without manually cloning / teeing\n- Allows for transforming values",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "0FYv9Eb8NYMTPpwP3ux2q",
      "type": "text",
      "x": 2114.524072481159,
      "y": 1134.051620824539,
      "width": 415.15972900390625,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Z",
      "roundness": null,
      "seed": 621957291,
      "version": 256,
      "versionNonce": 1351639586,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792620975478,
      "link": null,
      "locked": false,
      "text": "{\n    source = sourceIterable;\n\n    [Symbol.iterator()] {\n      const [left, right] = tee(this.source);\n      this.source = left;\n      return right;\n    }\n\n    transform(fn) {\n        this.source = fn(source);\n    }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n    source = sourceIterable;\n\n    [Symbol.iterator()] {\n      const [left, right] = tee(this.source);\n      this.source = left;\n      return right;\n    }\n\n    transform(fn) {\n        this.source = fn(source);\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "u7A32Tgs4cZT6RNi6tBGD",
      "type": "text",
      "x": 2807.1167798144666,
      "y": 630.9828622787198,
