      "link": null,
      "locked": false,
      "text": "function* parseMultipart(stream) {\n    const reader = stream.getReader()\n    let buffer = '';\n    while (true) {\n        const chunk = await reader.next();\n        // ...\n        yield data;\n    }  \n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function* parseMultipart(stream) {\n    const reader = stream.getReader()\n    let buffer = '';\n    while (true) {\n        const chunk = await reader.next();\n        // ...\n        yield data;\n    }  \n}",
